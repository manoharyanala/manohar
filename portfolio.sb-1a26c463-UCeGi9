<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alex Rivera | Professional Developer Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Semantic Header with Navbar -->
    <header class="navbar">
        <h1>Alex Rivera</h1>
        <nav>
            <ul>
                <li><a href="#about">About</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main>
        <!-- About Section with specific ID -->
        <section id="about" class="section-about">
            <h2>About Me</h2>
            <p>I am a front-end developer focused on creating responsive, accessible, and highly performant web applications. Passionate about turning complex design problems into elegant layout solutions using modern CSS mechanics.</p>
        </section>

        <!-- Projects Section with specific ID -->
        <section id="projects" class="section-projects">
            <h2>My Projects</h2>
            <div class="projects-grid">
                <!-- Project Card 1: Title, 1-line description, link -->
                <article class="project-card">
                    <h3>E-Commerce Interface</h3>
                    <p>A sleek storefront UI built using modern semantic structures and interactive item grids.</p>
                    <a href="https://github.com" target="_blank" class="project-link">View Project</a>
                </article>
                
                <!-- Project Card 2: Title, 1-line description, link -->
                <article class="project-card">
                    <h3>Task Management Dashboard</h3>
                    <p>An intuitive workflow tracker designed to organize daily objectives and project timelines.</p>
                    <a href="https://github.com" target="_blank" class="project-link">View Project</a>
                </article>
            </div>
        </section>
    </main>

    <!-- Footer with specific contact ID and required links -->
    <footer id="contact">
        <h2>Get in Touch</h2>
        <div class="contact-links">
            <a href="mailto:alex.rivera@example.com">Email</a>
            <a href="https://github.com" target="_blank">GitHub</a>
            <a href="https://linkedin.com" target="_blank">LinkedIn</a>
        </div>
        <p>&copy; 2026 Alex Rivera. All rights reserved.</p>
    </footer>

</body>
</html>
/* Color + Type System CSS Variables */
:root {
    --brand-primary: #0f766e;
    --brand-dark: #0f172a;
    --brand-light: #f8fafc;
    --text-main: #334155;
    --text-light: #ffffff;
    --font-heading: 'Helvetica Neue', Arial, sans-serif;
    --font-body: Georgia, serif;
}

/* Global Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    color: var(--text-main);
    background-color: var(--brand-light);
    line-height: 1.6;
}

h1, h2, h3 {
    font-family: var(--font-heading);
    color: var(--brand-dark);
}

/* Image containment rule to explicitly block overflow */
img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* Flexbox Layout Component (Header Row/Nav) */
.navbar {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--brand-dark);
    padding: 1.25rem;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar h1 {
    color: var(--text-light);
    margin-bottom: 0.75rem;
}

.navbar nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
}

.navbar nav a {
    color: var(--text-light);
    text-decoration: none;
    font-weight: 600;
}

/* Container Spacing */
main {
    padding: 2.5rem 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
}

.section-about {
    margin-bottom: 3.5rem;
}

.section-projects h2 {
    margin-bottom: 1.75rem;
}

/* CSS Grid Layout for Mobile (Enforces 1 Column) */
.projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.project-card {
    background: #ffffff;
    padding: 1.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
}

.project-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--brand-primary);
    text-decoration: none;
    font-weight: bold;
}

/* Flexbox Layout Component (Footer Elements) */
footer {
    background-color: var(--brand-dark);
    color: var(--text-light);
    text-align: center;
    padding: 3rem 1.25rem;
    margin-top: 4rem;
}

footer h2 {
    color: var(--text-light);
    margin-bottom: 1.25rem;
}

.contact-links {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin-bottom: 1.5rem;
}

.contact-links a {
    color: var(--text-light);
    text-decoration: none;
}

/* Responsiveness Breakpoint: Smoothly scales grid columns to 2 on desktop screens */
@media (min-width: 768px) {
    .navbar {
        flex-direction: row;
        justify-content: space-between;
        padding: 1.25rem 3rem;
    }
    
    .navbar h1 {
        margin-bottom: 0;
    }

    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
